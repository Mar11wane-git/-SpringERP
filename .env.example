# Copy to .env and fill in real values. Placeholders only - never commit .env.

# --- Database (MySQL 8) ---
DB_URL=jdbc:mysql://localhost:3306/springerp?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8
DB_USERNAME=springerp
DB_PASSWORD=change-me

# --- Security ---
# At least 32 random bytes, e.g. `openssl rand -base64 48`
APP_JWT_SECRET=change-me-to-a-long-random-value
# Access-token and refresh-token lifetimes (ISO-8601 durations)
APP_ACCESS_TOKEN_TTL=PT15M
APP_REFRESH_TOKEN_TTL=P7D
# true behind HTTPS (production); false only for plain-http local development
APP_COOKIE_SECURE=true
# Comma-separated origins allowed to call the API cross-origin (empty = same-origin only)
APP_CORS_ALLOWED_ORIGINS=

# --- First administrator (created only when the users table is empty) ---
APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
APP_BOOTSTRAP_ADMIN_PASSWORD=change-me-Str0ng

# --- Optional fictional demo dataset (never enable in production) ---
APP_DEMO_DATA=false
# Password for the demo users created per role (leave empty to skip demo users)
APP_DEMO_USER_PASSWORD=

# --- Docker Compose only ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=springerp
MYSQL_USER=springerp
MYSQL_PASSWORD=change-me
