# TLS termination with automatic certificates. Set DOMAIN in .env and point its
# DNS A record at the server before starting the "https" profile.
{$DOMAIN} {
    encode gzip
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"
    reverse_proxy frontend:8080 {
        header_up X-Forwarded-Proto https
    }
}
